# ============================================================
# DailyNewsAssistant configuration — copy to .env and edit
# DailyNewsAssistant 配置 —— 复制为 .env 后按需修改
# ============================================================

# ---- LLM provider: openrouter | deepseek | ollama | vllm | openvino ----
# LLM 提供方。首期用云端 API 验证功能，后续切 ollama / openvino 做本地推理。
LLM_PROVIDER=deepseek
# 主 provider 限流或失败时自动切换到备用 / fallback when primary is rate-limited
LLM_FALLBACK_PROVIDER=openrouter

# ---- OpenRouter (cloud) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- DeepSeek (cloud, backup / batch-friendly) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Ollama (local, Windows/Linux) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# ---- vLLM (local, Linux) — OpenAI-compatible endpoint ----
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- OpenVINO LLM (local, reserved for P9) ----
OPENVINO_LLM_DIR=
OPENVINO_LLM_DEVICE=GPU

# ---- Embeddings (always local) ----
EMBEDDING_MODEL=BAAI/bge-m3

# ---- TTS（全部走独立服务 Agent_TTS_Module，本项目内没有模型代码）----
# 服务地址。换机器（本机 CPU → 4060 那台）改的就是这一行
TTS_SERVICE_URL=http://127.0.0.1:8300
# 「高级配置」要打开的 TTS 图形界面（另一个进程、另一个端口）
TTS_GUI_URL=http://127.0.0.1:8301
# Agent_TTS_Module 的仓库根目录：**只为自动拉起服务而配**。
# 留空 = 不自动拉起，服务不在线时直接报不可用
TTS_MODULE_DIR=C:/path/to/Agent_TTS_Module
# 拉起服务用哪个解释器；留空 = 当前这个（同一个 conda 环境）
TTS_PYTHON=
TTS_AUTOSTART=true
# 拉起尝试次数与单次等待上限（冷启动要加载权重，给足）
TTS_START_ATTEMPTS=3
TTS_START_TIMEOUT=120
# 单段合成的 HTTP 超时。CPU 上 RTF≈13，一段 120 字要三四分钟，别设小
TTS_REQUEST_TIMEOUT=900
# 送进 TTS 前用一次 LLM 做朗读友好化（型号/公式/多音字/断句）。
# 这是音频产物唯一的 LLM 调用，很小；不想花就设 false
TTS_PREPROCESS=true
# 服务端产物（逐段 wav、字幕）拷进文章目录的哪个子目录
TTS_ARTIFACT_DIRNAME=tts
# 音色，留空用默认（主持人 Serena，嘉宾 Uncle_Fu）。两个角色不要设成同一个
TTS_VOICE_HOST=
TTS_VOICE_GUEST=

# ---- Sources ----
RSSHUB_BASE_URL=http://localhost:1200

# ---- Inbox: 远程投递接口 / remote link submission (feishu | dingtalk | email) ----
# 默认飞书机器人 + 长连接：手机上把链接发给机器人即可入库，无需公网 IP。
INBOX_PROVIDER=feishu
INBOX_ENABLED=false
# 处理完是否回执 / send acknowledgement reply
INBOX_SEND_RECEIPT=true

# 飞书自建应用凭证（开发者后台 > 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 允许投递的用户 open_id，逗号分隔。空 = 拒收全部（安全默认）
FEISHU_ALLOWED_USERS=

# 钉钉（备选 adapter）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=

# 邮箱（兜底 adapter：公司代理阻断 WSS 时启用）。IMAP_PASSWORD 用「应用专用密码」。
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
INBOX_ALLOWED_SENDERS=
INBOX_SUBJECT_PREFIX=DNA
INBOX_POLL_INTERVAL=300

# ---- Runtime ----
DEFAULT_LANGUAGE=zh          # zh | en | bilingual
OUTPUT_DIR=./outputs
DATA_DIR=./data
DB_PATH=./data/dna.db
MAX_ITEMS_PER_SOURCE=30
DIGEST_MAX_ENTRIES=15

# ---- Corporate proxy (leave blank if none) ----
# 公司代理（私人电脑部署时全部留空）。注意：Python 走代理，curl 不走。
# NO_PROXY 必须包含 localhost，否则本地 Ollama(11434) 与 RSSHub(1200) 会被代理拦截。
# NO_PROXY must cover localhost, otherwise local Ollama / RSSHub calls get proxied.
HTTP_PROXY=
HTTPS_PROXY=
FTP_PROXY=
NO_PROXY=localhost,127.0.0.1,0.0.0.0,::1,127.0.0.0/8,10.0.0.0/8,192.168.0.0/16
