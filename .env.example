# ============================================================
# DailyNewsAssistant configuration — copy to .env and edit
# DailyNewsAssistant 配置 —— 复制为 .env 后按需修改
# ============================================================

# ---- LLM provider: openrouter | deepseek | ollama | vllm | openvino ----
# LLM 提供方。首期用云端 API 验证功能，后续切 ollama / openvino 做本地推理。
LLM_PROVIDER=deepseek
# 主 provider 限流或失败时自动切换到备用 / fallback when primary is rate-limited
LLM_FALLBACK_PROVIDER=openrouter

# ---- OpenRouter (cloud) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- DeepSeek (cloud, backup / batch-friendly) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Ollama (local, Windows/Linux) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# ---- vLLM (local, Linux) — OpenAI-compatible endpoint ----
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- OpenVINO LLM (local, reserved for P9) ----
OPENVINO_LLM_DIR=
OPENVINO_LLM_DEVICE=GPU

# ---- Embeddings (always local) ----
EMBEDDING_MODEL=BAAI/bge-m3

# ---- TTS: qwen3_ov | edge ----
TTS_PROVIDER=qwen3_ov
QWEN3_TTS_MODEL_DIR=C:/Users/test/Downloads/xkd/openvino_notebooks/notebooks/qwen3-tts/Qwen3-TTS-CustomVoice-0.6B-OV
TTS_DEVICE=GPU
# 单人播报主音色 / 双人访谈第二音色
TTS_VOICE_HOST=
TTS_VOICE_GUEST=

# ---- Sources ----
RSSHUB_BASE_URL=http://localhost:1200

# ---- Inbox: 远程投递接口 / remote link submission (feishu | dingtalk | email) ----
# 默认飞书机器人 + 长连接：手机上把链接发给机器人即可入库，无需公网 IP。
INBOX_PROVIDER=feishu
INBOX_ENABLED=false
# 处理完是否回执 / send acknowledgement reply
INBOX_SEND_RECEIPT=true

# 飞书自建应用凭证（开发者后台 > 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 允许投递的用户 open_id，逗号分隔。空 = 拒收全部（安全默认）
FEISHU_ALLOWED_USERS=

# 钉钉（备选 adapter）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=

# 邮箱（兜底 adapter：公司代理阻断 WSS 时启用）。IMAP_PASSWORD 用「应用专用密码」。
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
INBOX_ALLOWED_SENDERS=
INBOX_SUBJECT_PREFIX=DNA
INBOX_POLL_INTERVAL=300

# ---- Runtime ----
DEFAULT_LANGUAGE=zh          # zh | en | bilingual
OUTPUT_DIR=./outputs
DATA_DIR=./data
DB_PATH=./data/dna.db
MAX_ITEMS_PER_SOURCE=30
DIGEST_MAX_ENTRIES=15

# ---- Corporate proxy (leave blank if none) ----
# 公司代理（私人电脑部署时全部留空）。注意：Python 走代理，curl 不走。
# NO_PROXY 必须包含 localhost，否则本地 Ollama(11434) 与 RSSHub(1200) 会被代理拦截。
# NO_PROXY must cover localhost, otherwise local Ollama / RSSHub calls get proxied.
HTTP_PROXY=
HTTPS_PROXY=
FTP_PROXY=
NO_PROXY=localhost,127.0.0.1,0.0.0.0,::1,127.0.0.0/8,10.0.0.0/8,192.168.0.0/16
