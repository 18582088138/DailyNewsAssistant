<?xml version="1.0" encoding="UTF-8"?>
<!--
  测试样例：一个真实世界形态的 RSS feed / A realistically messy RSS feed.
  刻意包含 / Deliberately includes:
    - 标题里的多余空白与换行（必须被压平）
    - 一条缺 pubDate 的条目（published_at 应为 None，而不是回填「现在」）
    - 一条缺 link 的条目（必须被跳过）
    - 一条缺 title 的条目（必须被跳过）
    - 带追踪参数的链接（规范化时才处理，解析阶段应原样保留）
-->
<rss version="2.0">
  <channel>
    <title>测试资讯源</title>
    <link>https://news.example.com</link>
    <description>用于单元测试的样例 feed</description>

    <item>
      <title>某公司发布新一代多模态大模型</title>
      <link>https://news.example.com/posts/1?utm_source=rss&amp;utm_medium=feed</link>
      <description>该模型支持图文音三模态输入，官方称推理成本下降四成。</description>
      <pubDate>Tue, 01 Sep 2026 09:30:00 GMT</pubDate>
    </item>

    <item>
      <title>
        开源社区发布
        新版推理框架
      </title>
      <link>https://news.example.com/posts/2</link>
      <description>新版本在长上下文场景下的吞吐提升明显。</description>
      <pubDate>Tue, 01 Sep 2026 08:00:00 GMT</pubDate>
    </item>

    <item>
      <title>缺少发布时间的条目</title>
      <link>https://news.example.com/posts/3</link>
      <description>这条没有 pubDate。</description>
    </item>

    <item>
      <title>这条没有链接，应被跳过</title>
      <description>没有 link 就无法抽正文。</description>
    </item>

    <item>
      <link>https://news.example.com/posts/5</link>
      <description>这条没有标题，应被跳过。</description>
    </item>
  </channel>
</rss>
